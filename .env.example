# --- Database (Google Sheets) ---
SPREADSHEET_ID=1AbC...idSpreadsheetAnda
GOOGLE_CLIENT_EMAIL=ujian-dkv@nama-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Keamanan ---
# Proyek ini belum pernah dipasang di akun Google (lihat PANDUAN_INSTALASI.md
# yang menyertainya), jadi tidak ada PIN lama yang perlu tetap kompatibel.
# Buat nilai acak baru bebas untuk keduanya:
HASH_SECRET=ganti-dengan-teks-acak-panjang
SESSION_SECRET=ganti-dengan-teks-acak-panjang-lainnya

# Hasil dari: node scripts/hash-secret.mjs "isi-HASH_SECRET" "kata-sandi-admin"
ADMIN_HASH=hasil-perintah-hash-secret

# --- Opsional ---
SESSION_TTL_SECONDS=21600

# Simpan tab SISWA/UJIAN/SOAL di memori instance selama sekian milidetik.
# Tidak mengurangi jumlah permintaan (batchGet sudah), hanya mempercepat respons.
# Konsekuensinya perubahan di spreadsheet telat terlihat selama masa ini.
# 0 atau dikosongkan = mati (standar). Nilai wajar kalau dipakai: 10000.
SHEET_CACHE_MS=0

# Pengacakan urutan soal per sesi. Aktifkan dengan YA jika sudah siap.
# Urutan konsisten saat siswa melanjutkan sesi yang sama.
SHUFFLE_QUESTIONS=NO
